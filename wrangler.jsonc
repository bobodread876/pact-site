// pactbond.org: static assets from dist/ (built by src/build.py), plus worker.js for byte ranges on /media/*
// (Safari and iOS play video only from 206 responses). The same setup as cashucard.org and fedimintcard.org.
// Preview a version without publishing it: npx wrangler versions upload. Publish: npx wrangler deploy.
{
  "name": "pact-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  "cache": { "enabled": true },
  "observability": { "enabled": true }
}
