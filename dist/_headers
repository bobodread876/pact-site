/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self'; media-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src wss://relay.islandbitcoin.com wss://relay.damus.io wss://nos.lol; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000

/
  Cache-Control: public, max-age=300

/install
  Cache-Control: public, max-age=300

/developers
  Cache-Control: public, max-age=300

/privacy
  Cache-Control: public, max-age=300

/board/
  Cache-Control: public, max-age=300

/assets/*
  Cache-Control: public, max-age=31536000, immutable


